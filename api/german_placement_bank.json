:"gp-20","month":3,"skill":"grammar","topic":"Reflexiv","prompt":"Er interessiert ___ für Musik.","options":["sich","mir","dir","wir","ihm"],"answer":0},{"id":"gp-21","month":3,"skill":"vocabulary","topic":"Safar","prompt":"Der Zug kommt später als geplant. Er hat ___.","options":["Urlaub","Verspätung","Erfolg","Besuch","Vorsprung"],"answer":1},{"id":"gp-22","month":3,"skill":"vocabulary","topic":"Ro‘yxatdan o‘tish","prompt":"Für den Kurs muss ich ein Formular ___.","options":["abfahren","einschlafen","ausfüllen","anziehen","ausgehen"],"answer":2},{"id":"gp-23","month":3,"skill":"reading","topic":"O‘tgan voqea","prompt":"Warum nahm Lea den Bus?","options":["Ihr Fahrrad war kaputt.","Es regnete.","Der Bus war kostenlos.","Sie hatte kein Fahrrad.","Ihr Auto war kaputt."],"answer":0,"text":"Lea wollte gestern mit dem Fahrrad zur Arbeit fahren. Doch der Reifen war kaputt. Deshalb nahm sie den Bus und kam zehn Minuten zu spät."},{"id":"gp-24","month":3,"skill":"reading","topic":"Reja o‘zgarishi","prompt":"Wann findet das Treffen statt?","options":["Heute um 16 Uhr","Morgen um 15 Uhr","Heute um 15 Uhr","Morgen um 16 Uhr","Übermorgen um 16 Uhr"],"answer":3,"text":"Hallo Tom, unser Treffen heute um 15 Uhr fällt aus. Können wir uns stattdessen morgen um 16 Uhr treffen? – Ja, das passt."},{"id":"gp-25","month":4,"skill":"grammar","topic":"Sifat turlanishi","prompt":"Ich suche einen ___ Mantel.","options":["warme","warmen","warmes","warmem","warmer"],"answer":1},{"id":"gp-26","month":4,"skill":"grammar","topic":"Taqqoslash","prompt":"Dieser Zug ist ___ als der Bus.","options":["schneller","schnellste","schnellsten","schnelles","mehr schnell"],"answer":0},{"id":"gp-27","month":4,"skill":"grammar","topic":"weil","prompt":"Ich bleibe zu Hause, weil ___.","options":["bin krank ich","bin ich krank","krank ich bin","ich krank bin","ich krank sein"],"answer":3},{"id":"gp-28","month":4,"skill":"grammar","topic":"Bilvosita savol","prompt":"Wissen Sie, ___ der nächste Zug abfährt?","options":["denn","dass","wann","weil","wenn"],"answer":2},{"id":"gp-29","month":4,"skill":"vocabulary","topic":"Uy-joy","prompt":"Zusätzlich zur Miete bezahlt man oft ___.","options":["Hausaufgaben","Nebenkosten","Zeugnisse","Fahrkarten","Nebenfächer"],"answer":1},{"id":"gp-30","month":4,"skill":"vocabulary","topic":"Taqqoslash","prompt":"Dieser Preis ist sehr günstig. Das bedeutet:","options":["besonders hoch","noch unbekannt","relativ niedrig","immer gleich","stark gestiegen"],"answer":2},{"id":"gp-31","month":4,"skill":"reading","topic":"Shart","prompt":"Wer bekommt den günstigeren Eintritt?","options":["Alle Besucher","Nur Kinder","Nur Erwachsene","Personen mit Studentenausweis","Studierende ohne Ausweis"],"answer":3,"text":"Der Eintritt kostet 12 Euro. Studierende zahlen mit gültigem Studentenausweis nur 8 Euro. Ohne Ausweis gilt der normale Preis."},{"id":"gp-32","month":4,"skill":"reading","topic":"Sabab va yechim","prompt":"Was bietet das Geschäft an?","options":["Das Geld sofort zurückzugeben.","Die Lieferung kostenlos zu bringen.","Die Ware teurer zu verkaufen.","Nur eine Abholung im Laden.","Die Bestellung früher zu liefern."],"answer":1,"text":"Ihre Bestellung kommt leider zwei Tage später, weil unser Lieferwagen ausgefallen ist. Als Entschuldigung berechnen wir Ihnen keine Versandkosten."},{"id":"gp-33","month":5,"skill":"grammar","topic":"obwohl","prompt":"___ es regnet, gehen wir spazieren.","options":["Obwohl","Deshalb","Trotzdem","Wegen","Trotz"],"answer":0},{"id":"gp-34","month":5,"skill":"grammar","topic":"Maqsad","prompt":"Ich lerne Deutsch, ___ in Deutschland zu studieren.","options":["damit","weil","um","dass","für"],"answer":2},{"id":"gp-35","month":5,"skill":"grammar","topic":"Relativsatz","prompt":"Das ist die Kollegin, ___ ich gestern geholfen habe.","options":["die","der","den","deren","dem"],"answer":1},{"id":"gp-36","month":5,"skill":"grammar","topic":"Plusquamperfekt","prompt":"Nachdem er gegessen ___, ging er zur Arbeit.","options":["hat","ist","war","hatte","haben"],"answer":3},{"id":"gp-37","month":5,"skill":"vocabulary","topic":"Dalillash","prompt":"Ein Vorteil ist eine ___ Seite einer Sache.","options":["positive","unbekannte","negative","unwichtige","neutrale"],"answer":0},{"id":"gp-38","month":5,"skill":"vocabulary","topic":"Mas’uliyat","prompt":"Wer Verantwortung übernimmt, ___.","options":["vermeidet jede Aufgabe","kümmert sich um die Folgen seines Handelns","gibt immer anderen die Schuld","macht grundsätzlich nichts","überlässt alle Entscheidungen anderen"],"answer":1},{"id":"gp-39","month":5,"skill":"reading","topic":"Qarama-qarshi fikr","prompt":"Was findet der Autor problematisch?","options":["Die tägliche Fahrt.","Die freie Zeiteinteilung.","Die fehlenden spontanen Gespräche.","Die kurzen Pausen.","Die zwei Bürotage pro Woche."],"answer":2,"text":"Im Homeoffice spare ich täglich eine Stunde Fahrt. Trotzdem möchte ich nicht immer zu Hause arbeiten: Mir fehlen die spontanen Gespräche mit Kollegen. Zwei Bürotage pro Woche wären für mich ideal."},{"id":"gp-40","month":5,"skill":"reading","topic":"Taklif maqsadi","prompt":"Warum soll die Bibliothek länger öffnen?","options":["Damit mehr Bücher verkauft werden.","Damit Angestellte früher gehen.","Damit Kinder dort schlafen können.","Damit Berufstätige sie nach der Arbeit nutzen können.","Damit Schüler dort länger lernen können."],"answer":3,"text":"Viele Beschäftigte können die Bibliothek vor 18 Uhr nicht erreichen. Der Verein schlägt deshalb vor, sie donnerstags bis 21 Uhr zu öffnen. An den übrigen Tagen sollen die bisherigen Zeiten gelten."},{"id":"gp-41","month":6,"skill":"grammar","topic":"Konjunktiv II","prompt":"Wenn ich mehr Zeit hätte, ___ ich öfter lesen.","options":["würde","werde","wurde","hatte","wird"],"answer":0},{"id":"gp-42","month":6,"skill":"grammar","topic":"Passiv","prompt":"Die Briefe ___ jeden Morgen sortiert.","options":["haben","sind gewesen","werden","hätten","wird"],"answer":2},{"id":"gp-43","month":6,"skill":"grammar","topic":"Fe’l va predlog","prompt":"Ich freue mich ___ den Urlaub nächste Woche.","options":["über","mit","bei","auf","für"],"answer":3},{"id":"gp-44","month":6,"skill":"grammar","topic":"O‘zaro bog‘lanish","prompt":"Je mehr ich übe, ___ sicherer werde ich.","options":["weil","desto","obwohl","damit","dann"],"answer":1},{"id":"gp-45","month":6,"skill":"vocabulary","topic":"Kelishuv","prompt":"Einen Kompromiss finden bedeutet:","options":["Eine Lösung finden, bei der beide Seiten etwas nachgeben.","Eine Seite entscheidet alles.","Das Gespräch sofort abbrechen.","Jede Änderung ablehnen.","Die Entscheidung auf später verschieben."],"answer":0},{"id":"gp-46","month":6,"skill":"vocabulary","topic":"Ish va hujjat","prompt":"In einer Bewerbung beschreibt man vor allem ___.","options":["das Wetter","seine Berufserfahrung und Qualifikationen","die Speisekarte","die Öffnungszeiten","seine Urlaubspläne"],"answer":1},{"id":"gp-47","month":6,"skill":"reading","topic":"Muallif munosabati","prompt":"Welche Aussage entspricht dem Text?","options":["Autos sollen überall verboten werden.","Busse sind immer leer.","Veränderungen müssen verschiedene Bedürfnisse berücksichtigen.","Nur Radfahrer brauchen sichere Wege.","Busse fahren schon jetzt zuverlässig."],"answer":2,"text":"Weniger Autos könnten die Innenstadt ruhiger machen. Ein vollständiges Verbot halte ich jedoch erst dann für sinnvoll, wenn Busse zuverlässig fahren und Menschen mit eingeschränkter Mobilität weiterhin ihre Ziele erreichen können."},{"id":"gp-48","month":6,"skill":"reading","topic":"Shartli qaror","prompt":"Unter welcher Bedingung beginnt das Projekt?","options":["Wenn alle im Urlaub sind.","Sobald ein Raum gefunden ist.","Auch ohne Geld.","Wenn die Finanzierung bis Freitag bestätigt wird.","Wenn die Aufgaben verteilt sind."],"answer":3,"text":"Das Team hat einen Raum gefunden und die Aufgaben verteilt. Der Start am Montag bleibt allerdings vorläufig: Nur wenn die Finanzierung bis Freitag bestätigt wird, kann das Projekt wie geplant beginnen."}]