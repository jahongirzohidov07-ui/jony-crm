{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": { "api/main.py": { "maxDuration": 30 } },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "5 0 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
